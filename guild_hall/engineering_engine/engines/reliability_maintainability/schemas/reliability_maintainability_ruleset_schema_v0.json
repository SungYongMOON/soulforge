{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.reliability_maintainability.ruleset_schema.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset_ref", "source_packet_ref", "rules"],
  "properties": {
    "schema_version": { "const": "soulforge.reliability_maintainability.ruleset.v0" },
    "ruleset_ref": { "$ref": "#/$defs/shaRef" },
    "source_packet_ref": { "$ref": "#/$defs/shaRef" },
    "base_ruleset_ref": { "$ref": "#/$defs/shaRef" },
    "profile_rule_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_kind", "profile_id", "revision_or_hash", "extends_or_base_pin", "operation_digest", "operation_item_digest", "operation_index", "source_refs", "order"],
        "properties": {
          "profile_kind": { "enum": ["organization", "project"] },
          "profile_id": { "type": "string" },
          "revision_or_hash": { "type": "string" },
          "extends_or_base_pin": { "type": "string" },
          "operation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operation_item_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operation_index": { "type": "integer", "minimum": 0 },
          "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "order": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "rules": { "type": "array", "minItems": 7, "maxItems": 64, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "shaRef": { "$ref": "soulforge.reliability_maintainability.domain_input_schema.v0#/$defs/shaRef" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "source_ref", "source_locator", "source_modality", "allowed_evidence_kinds", "required_authority_families", "context_ref_fields", "sufficiency_fields"],
      "properties": {
        "rule_id": { "type": "string" },
        "source_ref": { "type": "string" },
        "source_locator": { "type": "string" },
        "source_modality": { "type": "string" },
        "allowed_evidence_kinds": { "type": "array", "items": { "type": ["string", "null"] } },
        "required_authority_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "project_contract_baseline",
              "applicable_law_and_regulation",
              "company_approved_procedure",
              "acquisition_authority_manual",
              "general_se_guidance",
              "case_and_template",
              "reviewed_wiki",
              "llm_proposal"
            ]
          }
        },
        "context_ref_fields": { "type": "array", "items": { "type": "string" } },
        "sufficiency_fields": { "type": "array", "items": { "type": "string" } },
        "claim_ceiling": { "enum": ["source_supported", "observed"] }
      }
    }
  }
}
