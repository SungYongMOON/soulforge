{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.reliability_maintainability.domain_input_schema.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rows"],
  "properties": {
    "schema_version": { "const": "soulforge.reliability_maintainability.domain_input.v0" },
    "rows": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "shaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "revision_id", "content_id", "content_hash_alg"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/token" },
        "revision_id": { "$ref": "#/$defs/token" },
        "content_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "content_hash_alg": { "const": "sha256" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_binding", "jurisdiction", "time_window", "document_revision", "approval_scope"],
      "properties": {
        "project_binding": { "enum": [true, false, "unknown"] },
        "jurisdiction": { "enum": [true, false, "unknown"] },
        "time_window": { "enum": [true, false, "unknown"] },
        "document_revision": { "enum": [true, false, "unknown"] },
        "approval_scope": { "enum": [true, false, "unknown"] }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_family", "role_ref", "delegation_ref", "decision_ref"],
      "properties": {
        "authority_family": {
          "enum": [
            "project_contract_baseline",
            "applicable_law_and_regulation",
            "company_approved_procedure",
            "acquisition_authority_manual",
            "general_se_guidance",
            "case_and_template",
            "reviewed_wiki",
            "llm_proposal"
          ]
        },
        "role_ref": { "$ref": "#/$defs/shaRef" },
        "delegation_ref": { "$ref": "#/$defs/shaRef" },
        "decision_ref": { "$ref": "#/$defs/shaRef" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "authority_family", "source_revision_ref", "lineage_ref", "applicability", "asserted_value", "valid_at", "known_at"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/token" },
        "authority_family": {
          "enum": [
            "project_contract_baseline",
            "applicable_law_and_regulation",
            "company_approved_procedure",
            "acquisition_authority_manual",
            "general_se_guidance",
            "case_and_template",
            "reviewed_wiki",
            "llm_proposal"
          ]
        },
        "source_revision_ref": { "$ref": "#/$defs/shaRef" },
        "lineage_ref": { "$ref": "#/$defs/token" },
        "applicability": { "enum": [true, false, "unknown"] },
        "asserted_value": { "$ref": "#/$defs/token" },
        "valid_at": { "type": "string", "pattern": "Z$" },
        "known_at": { "type": "string", "pattern": "Z$" }
      }
    },
    "contextRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allocation_or_prediction_basis_ref": { "$ref": "#/$defs/shaRef" },
        "availability_input_basis_ref": { "$ref": "#/$defs/shaRef" },
        "availability_kind_ref": { "$ref": "#/$defs/shaRef" },
        "availability_model_or_calculation_ref": { "$ref": "#/$defs/shaRef" },
        "availability_requirement_ref": { "$ref": "#/$defs/shaRef" },
        "availability_result_ref": { "$ref": "#/$defs/shaRef" },
        "closure_authority_ref": { "$ref": "#/$defs/shaRef" },
        "configuration_baseline_ref": { "$ref": "#/$defs/shaRef" },
        "corrective_or_control_action_ref": { "$ref": "#/$defs/shaRef" },
        "criticality_method_ref": { "$ref": "#/$defs/shaRef" },
        "failure_mode_trace_ref": { "$ref": "#/$defs/shaRef" },
        "failure_or_anomaly_ref": { "$ref": "#/$defs/shaRef" },
        "fmeca_ref": { "$ref": "#/$defs/shaRef" },
        "fmeca_scope_ref": { "$ref": "#/$defs/shaRef" },
        "fmeca_update_ref": { "$ref": "#/$defs/shaRef" },
        "logistics_support_analysis_ref": { "$ref": "#/$defs/shaRef" },
        "maintainability_demo_plan_ref": { "$ref": "#/$defs/shaRef" },
        "maintainability_demo_procedure_ref": { "$ref": "#/$defs/shaRef" },
        "maintainability_demo_result_ref": { "$ref": "#/$defs/shaRef" },
        "maintainability_requirement_ref": { "$ref": "#/$defs/shaRef" },
        "maintenance_concept_ref": { "$ref": "#/$defs/shaRef" },
        "metric_calculation_or_model_ref": { "$ref": "#/$defs/shaRef" },
        "metric_cutoff_ref": { "$ref": "#/$defs/shaRef" },
        "metric_data_ref": { "$ref": "#/$defs/shaRef" },
        "metric_definition_ref": { "$ref": "#/$defs/shaRef" },
        "metric_time_basis_ref": { "$ref": "#/$defs/shaRef" },
        "model_revision_ref": { "$ref": "#/$defs/shaRef" },
        "model_scope_ref": { "$ref": "#/$defs/shaRef" },
        "reliability_model_ref": { "$ref": "#/$defs/shaRef" },
        "reliability_requirement_ref": { "$ref": "#/$defs/shaRef" },
        "requirement_comparison_ref": { "$ref": "#/$defs/shaRef" },
        "scope_ref": { "$ref": "#/$defs/shaRef" },
        "spares_analysis_ref": { "$ref": "#/$defs/shaRef" },
        "support_equipment_ref": { "$ref": "#/$defs/shaRef" },
        "support_resource_basis_ref": { "$ref": "#/$defs/shaRef" },
        "update_trigger_ref": { "$ref": "#/$defs/shaRef" },
        "verification_evidence_ref": { "$ref": "#/$defs/shaRef" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "rule_id", "stage_ref", "applicability", "context_refs", "authority_bindings", "observation_attempted", "presence_state", "evidence_refs", "evidence_kind"],
      "properties": {
        "case_id": { "$ref": "#/$defs/token" },
        "rule_id": { "type": "string" },
        "stage_ref": { "$ref": "#/$defs/shaRef" },
        "applicability": { "$ref": "#/$defs/applicability" },
        "context_refs": { "$ref": "#/$defs/contextRefs" },
        "authority_bindings": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/authorityBinding" } },
        "observation_attempted": { "type": "boolean" },
        "observation_attempt_ref": { "$ref": "#/$defs/shaRef" },
        "presence_state": { "enum": ["present", "absence_confirmed", "unknown"] },
        "evidence_refs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/shaRef" } },
        "evidence_kind": { "type": ["string", "null"], "enum": [null, "availability_analysis", "failure_closure_trace", "failure_repair_metric_record", "fmeca_record", "logistics_support_analysis", "maintainability_demonstration_record", "reliability_allocation_model"] },
        "not_applicable_basis_ref": { "$ref": "#/$defs/shaRef" },
        "evaluation_result_ref": { "$ref": "#/$defs/shaRef" },
        "evaluation_result_state": { "enum": ["criteria_met", "criteria_not_met", "unknown"] },
        "conflict_claims": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/claim" } }
      }
    }
  }
}
