{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.material_procurement_readiness.evaluation_receipt.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_digest", "result_digest", "project_binding_lineage", "erp_snapshot_ref", "facts_digest", "valid_at", "known_at", "effects"],
  "properties": {
    "schema_version": { "const": "soulforge.material_procurement_readiness.evaluation_receipt.v0" },
    "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "project_binding_lineage": { "$ref": "#/$defs/lineage" },
    "erp_snapshot_ref": { "$ref": "#/$defs/ref" },
    "facts_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "valid_at": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$" },
    "known_at": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$" },
    "effects": { "$ref": "#/$defs/effects" }
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "revision_id", "content_id", "content_hash_alg"],
      "properties": {
        "entity_id": { "type": "string" }, "revision_id": { "type": "string" },
        "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "content_hash_alg": { "const": "sha256" }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "domain_engine_id", "binding_revision_hash", "source_manifest_ref", "source_refs"],
      "properties": {
        "project_id": { "type": "string" }, "domain_engine_id": { "const": "material_procurement_readiness" },
        "binding_revision_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_manifest_ref": { "$ref": "#/$defs/ref" },
        "source_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["filesystem_write", "network", "erp_mutation", "purchase_order_mutation", "supplier_commitment", "task_creation"],
      "properties": {
        "filesystem_write": { "const": 0 }, "network": { "const": 0 }, "erp_mutation": { "const": 0 },
        "purchase_order_mutation": { "const": 0 }, "supplier_commitment": { "const": 0 }, "task_creation": { "const": 0 }
      }
    }
  }
}
