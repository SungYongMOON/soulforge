{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.material_procurement_readiness.typed_project_facts.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_binding", "erp_snapshot_ref", "fact_authority", "as_of_date", "rows", "valid_at", "known_at", "facts_digest"],
  "properties": {
    "schema_version": { "const": "soulforge.material_procurement_readiness.typed_project_facts.v1" },
    "project_binding": { "$ref": "#/$defs/project_binding" },
    "erp_snapshot_ref": { "$ref": "#/$defs/ref" },
    "fact_authority": { "const": "erp_owned_read_only_snapshot" },
    "as_of_date": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$" },
    "rows": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/row" } },
    "valid_at": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$" },
    "known_at": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$" },
    "facts_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "revision_id", "content_id", "content_hash_alg"],
      "properties": {
        "entity_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "revision_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "content_hash_alg": { "const": "sha256" }
      }
    },
    "material_need_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_need_ref", "source_ref", "open_purchase_quantity_proof_ref"],
      "properties": {
        "material_need_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "source_ref": { "$ref": "#/$defs/ref" },
        "open_purchase_quantity_proof_ref": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }
      }
    },
    "project_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "domain_engine_id", "binding_revision_hash", "source_manifest_ref", "source_refs", "erp_snapshot_ref", "fact_authority", "material_need_bindings"],
      "properties": {
        "schema_version": { "const": "soulforge.material_procurement_readiness.project_binding.v0" },
        "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "domain_engine_id": { "const": "material_procurement_readiness" },
        "binding_revision_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_manifest_ref": { "$ref": "#/$defs/ref" },
        "source_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/ref" } },
        "erp_snapshot_ref": { "$ref": "#/$defs/ref" },
        "fact_authority": { "const": "erp_owned_read_only_snapshot" },
        "material_need_bindings": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/material_need_binding" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_need_ref", "material_ref", "quantity_uom", "required_quantity", "available_quantity", "open_purchase_quantity", "received_quantity", "purchase_order_state", "need_date", "lead_time_days", "order_date", "planned_receipt_date", "promised_delivery_date", "confirmed_receipt_date", "receipt_required"],
      "properties": {
        "material_need_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "material_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "quantity_uom": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "required_quantity": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "available_quantity": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "open_purchase_quantity": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "received_quantity": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "purchase_order_state": { "enum": ["cancelled", "closed", "draft", "in_transit", "not_ordered", "released", "supplier_acknowledged", "unknown"] },
        "need_date": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "lead_time_days": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 3650 }, { "type": "null" }] },
        "order_date": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "planned_receipt_date": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "promised_delivery_date": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "confirmed_receipt_date": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "receipt_required": { "type": "boolean" }
      }
    }
  }
}
