{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.interface_consistency.domain_input.v0",
  "title": "Interface Consistency Domain Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "register_id", "register_revision", "interfaces"],
  "properties": {
    "schema_version": { "const": "soulforge.interface_consistency.domain_input.v0" },
    "register_id": { "$ref": "#/$defs/token" },
    "register_revision": { "$ref": "#/$defs/token" },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/interface" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "allOf": [
        { "not": { "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Ee][Mm])" } },
        { "not": { "pattern": "(?:[Ss][Kk]-(?:[Pp][Rr][Oo][Jj]-)?|[Gg][Hh][Pp]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Xx][Oo][Xx][Bb][Aa][Pp][Rr][Ss]-|[Aa][Ii][Zz][Aa])" } }
      ]
    },
    "revision_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["present", "known_absent", "unknown"] },
        "value": { "$ref": "#/$defs/token" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "present" } } },
          "then": { "type": "object", "properties": { "value": { "$ref": "#/$defs/token" } }, "required": ["value"] },
          "else": { "not": { "required": ["value"] } }
        }
      ]
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        { "not": { "pattern": "[\\u0000-\\u001f\\u007f]" } },
        { "not": { "pattern": "[\\u0300-\\u036f]" } },
        { "not": { "pattern": "\\\\\\\\[^\\\\/\\s]+[\\\\/][^\\\\/\\s]+" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9_])_[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee][Ss](?:[\\\\/]|$)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9_])_[Ww][Oo][Rr][Kk][Mm][Ee][Tt][Aa](?:[\\\\/]|$)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9_])[Pp][Rr][Ii][Vv][Aa][Tt][Ee]-[Ss][Tt][Aa][Tt][Ee](?:[\\\\/]|$)" } },
        {
          "anyOf": [
            { "pattern": "^https?:\\/\\/[A-Za-z0-9.-]+(?:\\/[^\\s]*)?$" },
            {
              "allOf": [
                { "not": { "pattern": "[A-Za-z]:[\\\\/]" } },
                { "not": { "pattern": "\\/(?:[Hh][Oo][Mm][Ee]|[Uu][Ss][Ee][Rr][Ss]|[Tt][Mm][Pp]|[Ee][Tt][Cc]|[Vv][Aa][Rr]|[Uu][Ss][Rr]|[Rr][Oo][Oo][Tt]|[Oo][Pp][Tt]|[Ss][Rr][Vv]|[Mm][Nn][Tt]|[Mm][Ee][Dd][Ii][Aa]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee][Ss]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Dd][Aa][Tt][Aa])(?:\\/|$)" } }
              ]
            }
          ]
        },
        { "not": { "pattern": "[Ff][Ii][Ll][Ee]:\\/\\/" } },
        { "not": { "pattern": "-----BEGIN [A-Z ]+[Pp][Rr][Ii][Vv][Aa][Tt][Ee] [Kk][Ee][Yy]-----" } },
        { "not": { "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Ee][Mm])" } },
        { "not": { "pattern": "(?:[Ss][Kk]-(?:[Pp][Rr][Oo][Jj]-)?|[Gg][Hh][Pp]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Xx][Oo][Xx][Bb][Aa][Pp][Rr][Ss]-|[Aa][Ii][Zz][Aa])" } },
        { "not": { "pattern": "^[+-]?\\d+(?:\\.\\d+)?[eE][+-]?\\d+$" } },
        {
          "anyOf": [
            { "not": { "pattern": "^\\d{4}-\\d{2}-\\d{2}T" } },
            { "pattern": "^(?:(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)|(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" }
          ]
        }
      ]
    },
    "bounded_scalar": {
      "oneOf": [
        { "$ref": "#/$defs/safe_text" },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "boolean" }
      ]
    },
    "bounded_value": { "$ref": "#/$defs/bounded_value_0" },
    "bounded_value_0": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/bounded_value_1" }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/token" },
          "additionalProperties": { "$ref": "#/$defs/bounded_value_1" }
        }
      ]
    },
    "bounded_value_1": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_2" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_2" } }
      ]
    },
    "bounded_value_2": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_3" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_3" } }
      ]
    },
    "bounded_value_3": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_4" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_4" } }
      ]
    },
    "bounded_value_4": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_5" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_5" } }
      ]
    },
    "bounded_value_5": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_6" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_6" } }
      ]
    },
    "bounded_value_6": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_7" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_7" } }
      ]
    },
    "bounded_value_7": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/bounded_value_8" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/token" }, "additionalProperties": { "$ref": "#/$defs/bounded_value_8" } }
      ]
    },
    "bounded_value_8": {
      "oneOf": [
        { "$ref": "#/$defs/bounded_scalar" }
      ]
    },
    "category_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "required_attributes"],
      "properties": {
        "applicability": { "enum": ["applicable", "not_applicable", "unknown"] },
        "required_attributes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute_id", "state"],
      "properties": {
        "attribute_id": { "$ref": "#/$defs/token" },
        "state": { "enum": ["present", "known_absent", "unknown"] },
        "value": { "$ref": "#/$defs/bounded_value" },
        "unit": { "$ref": "#/$defs/token" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "present" } } },
          "then": { "type": "object", "properties": { "value": { "$ref": "#/$defs/bounded_value" } }, "required": ["value"] },
          "else": { "not": { "anyOf": [
            { "type": "object", "properties": { "value": { "$ref": "#/$defs/bounded_value" } }, "required": ["value"] },
            { "type": "object", "properties": { "unit": { "$ref": "#/$defs/token" } }, "required": ["unit"] }
          ] } }
        }
      ]
    },
    "category_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributes"],
      "properties": {
        "attributes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/attribute" }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "electrical": { "$ref": "#/$defs/category_observation" },
        "signal": { "$ref": "#/$defs/category_observation" },
        "data_protocol": { "$ref": "#/$defs/category_observation" },
        "mechanical": { "$ref": "#/$defs/category_observation" },
        "timing": { "$ref": "#/$defs/category_observation" }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "revision"],
      "properties": {
        "state": { "enum": ["agreed", "not_agreed", "unknown"] },
        "revision": { "$ref": "#/$defs/revision_fact" }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end_id", "role", "revision", "agreement", "observations"],
      "properties": {
        "end_id": { "$ref": "#/$defs/token" },
        "role": { "enum": ["provider", "consumer", "bidirectional", "peer"] },
        "revision": { "$ref": "#/$defs/revision_fact" },
        "agreement": { "$ref": "#/$defs/agreement" },
        "observations": { "$ref": "#/$defs/observations" }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_id", "applicability", "revision", "category_scope", "ends"],
      "properties": {
        "interface_id": { "$ref": "#/$defs/token" },
        "applicability": { "enum": ["applicable", "not_applicable", "unknown"] },
        "revision": { "$ref": "#/$defs/revision_fact" },
        "category_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "electrical": { "$ref": "#/$defs/category_scope" },
            "signal": { "$ref": "#/$defs/category_scope" },
            "data_protocol": { "$ref": "#/$defs/category_scope" },
            "mechanical": { "$ref": "#/$defs/category_scope" },
            "timing": { "$ref": "#/$defs/category_scope" }
          }
        },
        "ends": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/end" } }
      }
    }
  }
}
