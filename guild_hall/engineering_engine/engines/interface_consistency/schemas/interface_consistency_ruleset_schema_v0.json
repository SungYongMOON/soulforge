{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.interface_consistency.ruleset.v0",
  "title": "Interface Consistency Effective Rule Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_ref",
    "source_packet_ref",
    "rules",
    "category_applicability",
    "profile_packages",
    "profile_rule_provenance"
  ],
  "properties": {
    "schema_version": { "const": "soulforge.interface_consistency.ruleset.v0" },
    "ruleset_ref": {
      "const": {
        "entity_id": "interface-consistency-ruleset-v0",
        "revision_id": "soulforge.interface_consistency.ruleset.v0",
        "content_id": "sha256:b21977554be56875ac2465d5fbb92c59d8114344bd9df4b2b7b96ce59b79fd3d",
        "content_hash_alg": "sha256"
      }
    },
    "source_packet_ref": {
      "const": {
        "entity_id": "interface-consistency-source-packet-v0",
        "revision_id": "interface-consistency-source-packet-v0",
        "content_id": "sha256:4105f0ae10fe126be2f068c078eff259a95c93746eff072f42356e7d36780580",
        "content_hash_alg": "sha256"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": { "rule_id": "IC-REG-01", "category": "interface_register", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S2_NASA_SP_2016_6105_REV_2"], "source_locators": ["ECSS Annex A.2.1<4>a,e,f", "NASA SP-2016-6105 Rev 2 §6.3.1.1"], "check_kind": "registered_interface_ends" } },
        { "const": { "rule_id": "IC-ELEC-01", "category": "electrical", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S2_NASA_SP_2016_6105_REV_2"], "source_locators": ["ECSS Annex A.2.1<4>i, <5>a", "NASA SP-2016-6105 Rev 2 §6.3"], "check_kind": "pairwise_declared_attribute_equality" } },
        { "const": { "rule_id": "IC-SIG-01", "category": "signal", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S2_NASA_SP_2016_6105_REV_2"], "source_locators": ["ECSS Annex A.2.1<4>a,g,i", "NASA SP-2016-6105 Rev 2 §6.3.1.2.2"], "check_kind": "pairwise_declared_attribute_equality" } },
        { "const": { "rule_id": "IC-DATA-01", "category": "data_protocol", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S3_DOD_DI_IPSC_81436_REV_A_NOTICE_3"], "source_locators": ["ECSS Annex A.2.1<4>g,i", "DI-IPSC-81436 §10.2"], "check_kind": "pairwise_declared_attribute_equality" } },
        { "const": { "rule_id": "IC-MECH-01", "category": "mechanical", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S2_NASA_SP_2016_6105_REV_2"], "source_locators": ["ECSS Annex A.2.1<5>a.5-a.6", "NASA SP-2016-6105 Rev 2 §6.3"], "check_kind": "pairwise_declared_attribute_equality" } },
        { "const": { "rule_id": "IC-TIME-01", "category": "timing", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S3_DOD_DI_IPSC_81436_REV_A_NOTICE_3"], "source_locators": ["ECSS Annex A.2.1<4>a,g", "DI-IPSC-81436 §10.2"], "check_kind": "pairwise_declared_attribute_equality" } },
        { "const": { "rule_id": "IC-REV-01", "category": "revision", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S2_NASA_SP_2016_6105_REV_2"], "source_locators": ["ECSS Annex A.2.1<2>b-c", "NASA SP-2016-6105 Rev 2 §6.3.1.2.3"], "check_kind": "interface_revision_alignment" } },
        { "const": { "rule_id": "IC-BILAT-01", "category": "bilateral_agreement", "source_refs": ["S1_ECSS_E_ST_10_24C_REV_1", "S2_NASA_SP_2016_6105_REV_2", "S4_IETF_RFC_9368"], "source_locators": ["ECSS Annex A.2.1<4>d-e", "NASA SP-2016-6105 Rev 2 §6.3.1.1", "RFC 9368 §§2.2-2.3,3"], "check_kind": "all_ends_agree_at_reconciled_revision" } }
      ],
      "items": false
    },
    "category_applicability": { "$ref": "#/$defs/category_applicability" },
    "profile_packages": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/profile_package" } },
    "profile_rule_provenance": { "$ref": "#/$defs/profile_rule_provenance" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "allOf": [
        { "not": { "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Ee][Mm])" } },
        { "not": { "pattern": "(?:[Ss][Kk]-(?:[Pp][Rr][Oo][Jj]-)?|[Gg][Hh][Pp]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Xx][Oo][Xx][Bb][Aa][Pp][Rr][Ss]-|[Aa][Ii][Zz][Aa])" } }
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
      "allOf": [
        { "not": { "pattern": "[A-Za-z]:[\\\\/]" } },
        { "not": { "pattern": "\\\\\\\\[^\\\\/\\s]+[\\\\/][^\\\\/\\s]+" } },
        { "not": { "pattern": "\\/(?:[Hh][Oo][Mm][Ee]|[Uu][Ss][Ee][Rr][Ss]|[Tt][Mm][Pp]|[Ee][Tt][Cc]|[Vv][Aa][Rr]|[Uu][Ss][Rr]|[Rr][Oo][Oo][Tt]|[Oo][Pp][Tt]|[Ss][Rr][Vv]|[Mm][Nn][Tt]|[Mm][Ee][Dd][Ii][Aa]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee][Ss]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Dd][Aa][Tt][Aa])(?:\\/|$)" } },
        { "not": { "pattern": "[Ff][Ii][Ll][Ee]:\\/\\/" } },
        { "not": { "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Ee][Mm])" } },
        { "not": { "pattern": "(?:[Ss][Kk]-(?:[Pp][Rr][Oo][Jj]-)?|[Gg][Hh][Pp]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Xx][Oo][Xx][Bb][Aa][Pp][Rr][Ss]-|[Aa][Ii][Zz][Aa])" } }
      ]
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "revision_id", "content_id", "content_hash_alg"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/token" },
        "revision_id": { "$ref": "#/$defs/source_ref" },
        "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "content_hash_alg": { "const": "sha256" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "category", "source_refs", "source_locators", "check_kind"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/token" },
        "category": { "enum": ["interface_register", "electrical", "signal", "data_protocol", "mechanical", "timing", "revision", "bilateral_agreement"] },
        "source_refs": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "source_locators": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9 .,_<>()§:-]{1,256}$" } },
        "check_kind": { "$ref": "#/$defs/token" }
      }
    },
    "category_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_register", "electrical", "signal", "data_protocol", "mechanical", "timing", "revision", "bilateral_agreement"],
      "properties": {
        "interface_register": { "type": ["boolean", "null"] },
        "electrical": { "type": ["boolean", "null"] },
        "signal": { "type": ["boolean", "null"] },
        "data_protocol": { "type": ["boolean", "null"] },
        "mechanical": { "type": ["boolean", "null"] },
        "timing": { "type": ["boolean", "null"] },
        "revision": { "type": ["boolean", "null"] },
        "bilateral_agreement": { "type": ["boolean", "null"] }
      }
    },
    "profile_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "category", "applicable"],
      "properties": {
        "op": { "const": "set_category_applicability" },
        "category": { "enum": ["interface_register", "electrical", "signal", "data_protocol", "mechanical", "timing", "revision", "bilateral_agreement"] },
        "applicable": { "type": "boolean" }
      }
    },
    "profile_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_kind", "profile_id", "domain_engine_id", "revision_or_hash", "extends_or_base_pin", "operation_digest", "source_refs", "order", "operations"],
      "properties": {
        "schema_version": { "const": "soulforge.engineering_profile_binding.v0" },
        "profile_kind": { "enum": ["organization", "project"] },
        "profile_id": { "$ref": "#/$defs/token" },
        "domain_engine_id": { "const": "interface_consistency" },
        "revision_or_hash": { "$ref": "#/$defs/token" },
        "extends_or_base_pin": { "$ref": "#/$defs/token" },
        "operation_digest": { "$ref": "#/$defs/digest" },
        "source_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/source_ref" } },
        "order": { "type": "integer", "minimum": 0, "maximum": 1 },
        "operations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/profile_operation" } }
      }
    },
    "operation_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_package_index", "operation_index"],
      "properties": {
        "profile_package_index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "operation_index": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "profile_rule_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_register": { "$ref": "#/$defs/operation_provenance" },
        "electrical": { "$ref": "#/$defs/operation_provenance" },
        "signal": { "$ref": "#/$defs/operation_provenance" },
        "data_protocol": { "$ref": "#/$defs/operation_provenance" },
        "mechanical": { "$ref": "#/$defs/operation_provenance" },
        "timing": { "$ref": "#/$defs/operation_provenance" },
        "revision": { "$ref": "#/$defs/operation_provenance" },
        "bilateral_agreement": { "$ref": "#/$defs/operation_provenance" }
      }
    }
  }
}
