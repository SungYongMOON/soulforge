{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.pcb_compliance.domain_descriptor.v0",
  "title": "PcbComplianceEngineDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain_engine_id",
    "display_name",
    "version",
    "status",
    "claim_ceiling",
    "execution_mode",
    "contracts",
    "schemas",
    "compiler_adapter",
    "evaluator_adapter",
    "fixtures",
    "manual"
  ],
  "properties": {
    "schema_version": { "const": "soulforge.domain_engine_descriptor.v0" },
    "domain_engine_id": { "const": "pcb_compliance" },
    "display_name": { "const": "PCB Compliance Domain Engine" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "const": "candidate" },
    "claim_ceiling": { "const": "source_supported" },
    "execution_mode": { "const": "deterministic_only" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_packet", "source_inventory", "integration_request"],
      "properties": {
        "source_packet": { "type": "string", "minLength": 1 },
        "source_inventory": { "type": "string", "minLength": 1 },
        "integration_request": { "type": "string", "minLength": 1 }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "ruleset", "domain_input", "assessment", "domain_result", "receipt"],
      "properties": {
        "request": { "const": "soulforge.pcb_compliance.request.v0" },
        "ruleset": { "const": "soulforge.pcb_compliance.ruleset.v0" },
        "domain_input": { "const": "soulforge.pcb_compliance.domain_input.v0" },
        "assessment": { "const": "soulforge.pcb_compliance.assessment.v0" },
        "domain_result": { "const": "soulforge.pcb_compliance.domain_result.v0" },
        "receipt": { "const": "soulforge.pcb_compliance.receipt.v0" }
      }
    },
    "compiler_adapter": { "type": "string", "minLength": 1 },
    "evaluator_adapter": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_synthetic"],
      "properties": {
        "public_synthetic": { "type": "string", "minLength": 1 }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 }
      }
    }
  }
}
