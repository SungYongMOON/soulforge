{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.calibration_measurement_validity.schema.v0",
  "title": "CalibrationMeasurementValidityEngineDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain_engine_id",
    "display_name",
    "version",
    "status",
    "claim_ceiling",
    "execution_mode",
    "contracts",
    "schemas",
    "compiler_adapter",
    "evaluator_adapter",
    "fixtures",
    "manual"
  ],
  "properties": {
    "schema_version": { "const": "soulforge.domain_engine_descriptor.v0" },
    "domain_engine_id": { "const": "calibration_measurement_validity" },
    "display_name": { "const": "Calibration and Measurement Validity Domain Engine" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "const": "candidate" },
    "claim_ceiling": { "const": "source_supported" },
    "execution_mode": { "const": "deterministic_only" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_packet", "public_source_inventory", "source_rag_profile", "build_mission"],
      "properties": {
        "source_packet": { "type": "string", "minLength": 1 },
        "public_source_inventory": { "type": "string", "minLength": 1 },
        "source_rag_profile": { "type": "string", "minLength": 1 },
        "build_mission": { "type": "string", "minLength": 1 }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset",
        "domain_input",
        "assessment",
        "receipt",
        "source_bound",
        "guidance",
        "read_only_mcp",
        "zero_write_pilot"
      ],
      "properties": {
        "ruleset": { "const": "soulforge.calibration_measurement_validity.ruleset.v0" },
        "domain_input": { "const": "soulforge.calibration_measurement_validity.domain_input.v0" },
        "assessment": { "const": "soulforge.calibration_measurement_validity.assessment.v0" },
        "receipt": { "const": "soulforge.calibration_measurement_validity.receipt.v0" },
        "source_bound": { "const": "soulforge.calibration_measurement_validity.source_bound_schema.v1" },
        "guidance": { "const": "soulforge.calibration_measurement_validity.guidance.v1" },
        "read_only_mcp": { "const": "soulforge.calibration_measurement_validity.read_only_mcp.v1" },
        "zero_write_pilot": { "const": "soulforge.calibration_measurement_validity.zero_write_pilot.v1" }
      }
    },
    "compiler_adapter": { "type": "string", "minLength": 1 },
    "evaluator_adapter": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_synthetic", "zero_write_pilot"],
      "properties": {
        "public_synthetic": { "type": "string", "minLength": 1 },
        "zero_write_pilot": { "type": "string", "minLength": 1 }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "revision_id", "content_id"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "content_hash_alg": { "enum": ["sha256"] }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "unit"],
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "domain_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_binding_ref",
        "evaluation_context",
        "instrument",
        "requested_measurement",
        "calibration_capability",
        "traceability",
        "environment",
        "exception"
      ],
      "properties": {
        "schema_version": { "const": "soulforge.calibration_measurement_validity.domain_input.v0" },
        "project_binding_ref": { "$ref": "#/$defs/reference" },
        "evaluation_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test_id", "tested_at", "known_at"],
          "properties": {
            "test_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "tested_at": { "type": "string", "format": "date-time" },
            "known_at": { "type": "string", "format": "date-time" }
          }
        },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instrument_id", "identity_ref", "calibration"],
          "properties": {
            "instrument_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "identity_ref": { "$ref": "#/$defs/reference" },
            "calibration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": { "enum": ["in_calibration", "expired", "out_of_service", "unknown"] },
                "certificate_ref": { "$ref": "#/$defs/reference" },
                "due_at": { "type": "string", "format": "date-time" },
                "valid_from": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "requested_measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["range", "required_accuracy_limit", "maximum_uncertainty"],
          "properties": {
            "range": { "$ref": "#/$defs/range" },
            "required_accuracy_limit": { "$ref": "#/$defs/quantity" },
            "maximum_uncertainty": { "$ref": "#/$defs/quantity" }
          }
        },
        "calibration_capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["range", "accuracy_limit", "uncertainty"],
          "properties": {
            "range": { "$ref": "#/$defs/range" },
            "accuracy_limit": { "$ref": "#/$defs/quantity" },
            "uncertainty": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expanded"],
              "properties": {
                "expanded": { "$ref": "#/$defs/quantity" }
              }
            }
          }
        },
        "traceability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["documented", "not_documented", "unknown"] },
            "chain_ref": { "$ref": "#/$defs/reference" }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["within_limit", "out_of_limit", "not_applicable", "unknown"] },
            "record_ref": { "$ref": "#/$defs/reference" },
            "not_applicable_basis_ref": { "$ref": "#/$defs/reference" }
          }
        },
        "exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["none", "approved_hold", "unapproved", "unknown"] },
            "exception_ref": { "$ref": "#/$defs/reference" },
            "approval_ref": { "$ref": "#/$defs/reference" }
          }
        }
      }
    },
    "determination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "status", "reason_code", "source_refs"],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["valid", "missing", "unknown", "expired", "out_of_range", "not_suitable", "exception_held", "not_applicable", "held", "invalid"] },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "domain_engine_id", "claim_ceiling", "project_binding_ref", "evaluated_at", "result_status", "result_impact", "determinations"],
      "properties": {
        "schema_version": { "const": "soulforge.calibration_measurement_validity.assessment.v0" },
        "domain_engine_id": { "const": "calibration_measurement_validity" },
        "claim_ceiling": { "enum": ["observed", "source_supported"] },
        "project_binding_ref": { "$ref": "#/$defs/reference" },
        "evaluated_at": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tested_at", "known_at"],
          "properties": {
            "tested_at": { "type": "string", "format": "date-time" },
            "known_at": { "type": "string", "format": "date-time" }
          }
        },
        "result_status": { "enum": ["valid", "unknown", "held", "invalid"] },
        "result_impact": { "enum": ["none", "hold", "invalidate"] },
        "determinations": { "type": "array", "minItems": 9, "maxItems": 10, "items": { "$ref": "#/$defs/determination" } },
        "profile_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "status", "claim_ceiling", "requirements", "hold_codes"],
          "properties": {
            "schema_version": { "const": "soulforge.calibration_measurement_validity.source_bound_profile.v1" },
            "status": { "enum": ["supported", "hold", "not_applicable"] },
            "claim_ceiling": { "enum": ["observed", "source_supported"] },
            "requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["requirement_id", "status", "required_source_ids", "required_classification", "profile_id"],
                "properties": {
                  "requirement_id": { "type": "string", "pattern": "^cmv-[a-z0-9][a-z0-9_-]{1,80}$" },
                  "status": { "enum": ["supported", "hold"] },
                  "required_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
                  "required_classification": { "const": "official_public_direct" },
                  "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 }
                }
              }
            },
            "hold_codes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "required_fact_paths", "source_refs", "purpose"],
      "properties": {
        "criterion_id": {
          "enum": [
            "CMV-INSTRUMENT-IDENTITY-01",
            "CMV-CALIBRATION-STATUS-01",
            "CMV-RANGE-01",
            "CMV-ACCURACY-01",
            "CMV-UNCERTAINTY-01",
            "CMV-TRACEABILITY-01",
            "CMV-ENVIRONMENT-01",
            "CMV-EXCEPTION-01",
            "CMV-RESULT-IMPACT-01"
          ]
        },
        "required_fact_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "profile_rule_provenance_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_kind",
        "profile_id",
        "revision_or_hash",
        "extends_or_base_pin",
        "operation_digest",
        "operation_index",
        "operation_item_digest",
        "source_refs",
        "order"
      ],
      "properties": {
        "profile_kind": { "enum": ["organization", "project"] },
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision_or_hash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "extends_or_base_pin": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "operation_index": { "type": "integer", "minimum": 0 },
        "operation_item_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "profile_rule_provenance": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile_rule_provenance_row" },
      "propertyNames": { "pattern": "^cmv-[a-z0-9][a-z0-9_-]{1,80}$" }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "domain_engine_id", "ruleset_ref", "source_packet_ref", "rules", "rule_count"],
      "properties": {
        "schema_version": { "const": "soulforge.calibration_measurement_validity.ruleset.v0" },
        "domain_engine_id": { "const": "calibration_measurement_validity" },
        "ruleset_ref": { "$ref": "#/$defs/reference" },
        "source_packet_ref": { "$ref": "#/$defs/reference" },
        "profile_rule_provenance": { "$ref": "#/$defs/profile_rule_provenance" },
        "source_bound_profile_requirements": { "type": "array", "items": { "$ref": "#/$defs/source_bound_profile_requirement" } },
        "rules": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/rule" } },
        "rule_count": { "type": "integer", "const": 9 }
      }
    },
    "source_bound_profile_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "required_source_ids", "required_classification", "profile_kind", "profile_id", "revision_or_hash", "extends_or_base_pin", "operation_digest", "source_refs", "order", "operation_index"],
      "properties": {
        "requirement_id": { "type": "string", "pattern": "^cmv-[a-z0-9][a-z0-9_-]{1,80}$" },
        "required_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "required_classification": { "const": "official_public_direct" },
        "profile_kind": { "enum": ["organization", "project"] },
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision_or_hash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "extends_or_base_pin": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "order": { "type": "integer", "minimum": 0 },
        "operation_index": { "type": "integer", "minimum": 0 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_mode",
        "source_packet_ref",
        "ruleset_ref",
        "input_sha256",
        "assessment_sha256",
        "replay_digest",
        "effects"
      ],
      "properties": {
        "schema_version": { "const": "soulforge.calibration_measurement_validity.receipt.v0" },
        "execution_mode": { "const": "deterministic_only" },
        "source_packet_ref": { "$ref": "#/$defs/reference" },
        "ruleset_ref": { "$ref": "#/$defs/reference" },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assessment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "replay_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network_calls", "file_reads", "file_writes", "external_mutations"],
          "properties": {
            "network_calls": { "const": 0 },
            "file_reads": { "const": 0 },
            "file_writes": { "const": 0 },
            "external_mutations": { "const": 0 }
          }
        },
        "profile_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "status", "digest"],
          "properties": {
            "schema_version": { "const": "soulforge.calibration_measurement_validity.source_bound_profile.v1" },
            "status": { "enum": ["supported", "hold", "not_applicable"] },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}
