{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.safety_hazard_typed_project_facts.v0",
  "title": "SafetyHazardTypedProjectFacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_binding_ref", "facts", "facts_digest", "valid_at", "known_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "soulforge.typed_project_facts.v0" },
    "project_binding_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "domain_engine_id", "binding_revision_hash", "source_manifest_ref"],
      "properties": {
        "schema_version": { "type": "string", "const": "soulforge.project_binding.v0" },
        "project_id": { "type": "string", "minLength": 1 },
        "domain_engine_id": { "type": "string", "const": "safety_hazard" },
        "binding_revision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_manifest_ref": { "type": "string", "minLength": 1 },
        "authority_family": { "type": "string" },
        "valid_at": { "type": "string", "format": "date-time" },
        "known_at": { "type": "string", "format": "date-time" },
        "document_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_kind", "project_id", "request_binding_ref", "request_cutoff_ref", "request_digest", "request"],
        "properties": {
          "fact_kind": { "type": "string", "const": "safety_hazard_evaluation_request" },
          "project_id": { "type": "string", "minLength": 1 },
          "request_binding_ref": { "type": "object" },
          "request_cutoff_ref": { "type": "object" },
          "request_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest", "binding", "domain_input", "cutoffs"],
            "properties": {
              "manifest": { "type": "object" },
              "binding": { "type": "object" },
              "domain_input": { "type": "object" },
              "cutoffs": { "type": "object" }
            }
          }
        }
      }
    },
    "facts_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "valid_at": { "type": "string", "format": "date-time" },
    "known_at": { "type": "string", "format": "date-time" }
  }
}
