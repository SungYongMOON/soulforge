{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.database_engineering.project_binding.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "domain_engine_id", "binding_revision_hash", "platform", "source_refs"],
  "properties": {
    "schema_version": {"const": "soulforge.database_engineering.project_binding.v0"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,80}$"},
    "domain_engine_id": {"const": "database_engineering"},
    "binding_revision_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "platform": {"$ref": "#/$defs/platform"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/opaque_ref"}}
  },
  "$defs": {
    "opaque_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version"],
      "properties": {"family": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    }
  }
}
