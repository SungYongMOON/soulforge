{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schema/instruction_manifest.v1.schema.json",
  "title": "Soulforge AI Instruction Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "observed_at", "codex_version", "prompt_probe_status", "sources", "source_count", "chain_digest", "total_instruction_bytes", "model_visible_prompt_digest", "model_visible_prompt_bytes", "truncated", "privacy"],
  "properties": {
    "schema_version": { "const": "soulforge.ai_instruction_manifest.v1" },
    "manifest_id": { "type": "string", "pattern": "^aim_[a-f0-9]{64}$" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "codex_version": { "type": ["string", "null"], "maxLength": 120 },
    "prompt_probe_status": { "enum": ["completed", "completed_with_unverified_sources", "failed"] },
    "sources": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/source" } },
    "source_count": { "$ref": "#/$defs/count" },
    "chain_digest": { "$ref": "#/$defs/digest" },
    "total_instruction_bytes": { "$ref": "#/$defs/count" },
    "model_visible_prompt_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "model_visible_prompt_bytes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] },
    "truncated": { "type": ["boolean", "null"] },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_only", "source_content_copied", "prompt_content_copied"],
      "properties": {
        "metadata_only": { "const": true },
        "source_content_copied": { "const": false },
        "prompt_content_copied": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "scope", "access_status", "sha256", "bytes", "model_visible"],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$" },
        "scope": { "enum": ["global", "root", "nested"] },
        "access_status": { "enum": ["inspected_public", "prohibited", "unavailable"] },
        "sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "bytes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] },
        "model_visible": { "enum": ["included", "excluded", "unknown"] }
      }
    }
  }
}
