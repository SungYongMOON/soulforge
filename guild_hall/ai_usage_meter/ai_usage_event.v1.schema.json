{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schema/ai_usage_event.v1.schema.json",
  "title": "Soulforge AI Usage Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "organization_id",
    "team_id",
    "project_id",
    "work_id",
    "thread_id",
    "turn_id",
    "parent_thread_id",
    "root_thread_id",
    "root_turn_id",
    "source",
    "actor",
    "model",
    "usage",
    "credits",
    "time",
    "rate_limit_snapshot",
    "measurement",
    "privacy"
  ],
  "properties": {
    "schema_version": { "const": "soulforge.ai_usage_event.v1" },
    "event_id": { "$ref": "#/$defs/id" },
    "organization_id": { "$ref": "#/$defs/id" },
    "team_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "work_id": { "$ref": "#/$defs/id" },
    "thread_id": { "$ref": "#/$defs/id" },
    "turn_id": { "$ref": "#/$defs/id" },
    "parent_thread_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "root_thread_id": { "$ref": "#/$defs/id" },
    "root_turn_id": { "$ref": "#/$defs/id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_ref", "originator"],
      "properties": {
        "kind": {
          "enum": ["codex_session_jsonl", "claude_session_jsonl", "antigravity_conversation_db"]
        },
        "source_ref": { "$ref": "#/$defs/text" },
        "originator": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "agent_id", "agent_depth", "role"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "agent_id": { "$ref": "#/$defs/text" },
        "agent_depth": { "$ref": "#/$defs/nonnegative_integer" },
        "role": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reasoning_effort", "service_tier", "context_window"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "reasoning_effort": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "service_tier": { "$ref": "#/$defs/id" },
        "context_window": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonnegative_integer" }] }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens",
        "uncached_input_tokens",
        "model_invocation_count",
        "max_invocation_input_tokens"
      ],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "cached_input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "cache_write_input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "output_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "reasoning_output_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "total_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "uncached_input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "model_invocation_count": { "$ref": "#/$defs/nonnegative_integer" },
        "max_invocation_input_tokens": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rate_card_id", "service_tier", "total", "components"],
      "properties": {
        "status": { "enum": ["calculated", "rate_unknown"] },
        "rate_card_id": { "$ref": "#/$defs/text" },
        "service_tier": { "$ref": "#/$defs/id" },
        "total": { "type": ["number", "null"], "minimum": 0 },
        "components": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["uncached_input", "cached_input", "cache_write_input", "output"],
              "properties": {
                "uncached_input": { "type": "number", "minimum": 0 },
                "cached_input": { "type": "number", "minimum": 0 },
                "cache_write_input": { "type": "number", "minimum": 0 },
                "output": { "type": "number", "minimum": 0 }
              }
            }
          ]
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "duration_ms"],
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
        "duration_ms": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonnegative_integer" }] }
      }
    },
    "rate_limit_snapshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit_id", "used_percent", "window_minutes", "resets_at_epoch_s", "plan_type"],
          "properties": {
            "limit_id": { "$ref": "#/$defs/text" },
            "used_percent": { "type": "number", "minimum": 0 },
            "window_minutes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonnegative_integer" }] },
            "resets_at_epoch_s": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonnegative_integer" }] },
            "plan_type": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "token_confidence", "attribution_confidence"],
      "properties": {
        "status": { "enum": ["complete", "active", "observed_at_stop"] },
        "token_confidence": {
          "enum": ["exact_cumulative_delta", "exact_per_message", "request_count_only"]
        },
        "attribution_confidence": { "enum": ["explicit_binding", "derived_lineage"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_only", "prompt_captured", "reasoning_captured", "tool_payload_captured"],
      "properties": {
        "metadata_only": { "const": true },
        "prompt_captured": { "const": false },
        "reasoning_captured": { "const": false },
        "tool_payload_captured": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "source": { "type": "object", "properties": { "kind": { "const": "codex_session_jsonl" } } } }
      },
      "then": {
        "type": "object",
        "properties": {
          "measurement": { "type": "object", "properties": { "token_confidence": { "const": "exact_cumulative_delta" } } }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "source": { "type": "object", "properties": { "kind": { "const": "claude_session_jsonl" } } } }
      },
      "then": {
        "type": "object",
        "properties": {
          "measurement": { "type": "object", "properties": { "token_confidence": { "const": "exact_per_message" } } }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "source": { "type": "object", "properties": { "kind": { "const": "antigravity_conversation_db" } } } }
      },
      "then": {
        "type": "object",
        "properties": {
          "measurement": { "type": "object", "properties": { "token_confidence": { "const": "request_count_only" } } }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
