{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schema/ai_work_run.v1.schema.json",
  "title": "Soulforge AI Work Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "work_id", "run_scope", "cost_role", "variant", "task_class", "risk_class", "experiment_id", "repo_commit", "launcher_version", "topology", "cost_scope", "work_record_ref", "started_at", "completed_at", "model_id", "reasoning_effort", "usage_event_ids", "instruction_manifest_ref", "measurement_status", "authority", "metadata_only", "raw_prompt_copied", "raw_reasoning_copied", "raw_tool_payload_copied"],
  "properties": {
    "schema_version": { "const": "soulforge.ai_work_run.v1" },
    "event_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "work_id": { "$ref": "#/$defs/id" },
    "run_scope": { "enum": ["operational", "experiment"] },
    "cost_role": { "enum": ["execution", "coordination", "verification", "rework", "other"] },
    "variant": { "enum": ["control", "candidate"] },
    "task_class": { "$ref": "#/$defs/id" },
    "risk_class": { "$ref": "#/$defs/id" },
    "experiment_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "repo_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit_ref" }] },
    "launcher_version": { "$ref": "#/$defs/id" },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_max_depth", "expected_max_children", "reviewer_policy", "preflight_policy"],
      "properties": {
        "expected_max_depth": { "$ref": "#/$defs/count" },
        "expected_max_children": { "$ref": "#/$defs/count" },
        "reviewer_policy": { "$ref": "#/$defs/id" },
        "preflight_policy": { "$ref": "#/$defs/id" }
      }
    },
    "cost_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_included", "executor_included", "reviewer_included", "offline_oracle_included"],
      "properties": {
        "controller_included": { "type": "boolean" },
        "executor_included": { "type": "boolean" },
        "reviewer_included": { "type": "boolean" },
        "offline_oracle_included": { "type": "boolean" }
      }
    },
    "work_record_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "completed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "model_id": { "$ref": "#/$defs/id" },
    "reasoning_effort": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "usage_event_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "instruction_manifest_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "measurement_status": { "enum": ["complete", "partial", "unknown"] },
    "authority": { "const": "non_authoritative_measurement_projection" },
    "metadata_only": { "const": true },
    "raw_prompt_copied": { "const": false },
    "raw_reasoning_copied": { "const": false },
    "raw_tool_payload_copied": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$" },
    "commit_ref": { "type": "string", "pattern": "^(?:sha256:[a-f0-9]{64}|[a-f0-9]{7,64})$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
