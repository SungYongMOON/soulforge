{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schema/ai_tool_event.v1.schema.json",
  "title": "Soulforge AI Tool Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "work_id", "tool_name", "tool_class", "tool_call_id", "attempt", "timeout", "retry_reason_code", "preflight_receipt_id", "phase", "occurred_at", "duration_ms", "outcome", "input_digest", "output_digest", "metadata_only", "raw_prompt_copied", "raw_reasoning_copied", "raw_tool_payload_copied"],
  "properties": {
    "schema_version": { "const": "soulforge.ai_tool_event.v1" },
    "event_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "work_id": { "$ref": "#/$defs/id" },
    "tool_name": { "$ref": "#/$defs/id" },
    "tool_class": { "$ref": "#/$defs/id" },
    "tool_call_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "attempt": { "$ref": "#/$defs/count" },
    "timeout": { "type": "boolean" },
    "retry_reason_code": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "preflight_receipt_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "phase": { "enum": ["started", "completed", "failed"] },
    "occurred_at": { "$ref": "#/$defs/timestamp" },
    "duration_ms": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] },
    "outcome": { "enum": ["pending", "succeeded", "failed", "blocked", "unknown"] },
    "input_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "output_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "metadata_only": { "const": true },
    "raw_prompt_copied": { "const": false },
    "raw_reasoning_copied": { "const": false },
    "raw_tool_payload_copied": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
