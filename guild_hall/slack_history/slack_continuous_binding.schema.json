{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schemas/slack_continuous_binding.schema.json",
  "title": "Soulforge Slack continuous ingress private binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_enabled",
    "binding_id",
    "workspace_id",
    "channel_id",
    "project_code",
    "channel",
    "credentials",
    "attachment_policy",
    "private_root",
    "data_root",
    "forbidden_roots",
    "writer"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "soulforge.slack_continuous.binding.v1",
        "soulforge.slack_continuous.binding.v2"
      ]
    },
    "feature_enabled": {
      "type": "boolean"
    },
    "binding_id": {
      "$ref": "#/$defs/safeRef"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^T[A-Z0-9]{2,31}$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^C[A-Z0-9]{2,31}$"
    },
    "project_code": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "visibility",
        "is_shared",
        "is_ext_shared",
        "is_archived",
        "is_member"
      ],
      "properties": {
        "kind": {
          "const": "project"
        },
        "visibility": {
          "const": "public"
        },
        "is_shared": {
          "const": false
        },
        "is_ext_shared": {
          "const": false
        },
        "is_archived": {
          "const": false
        },
        "is_member": {
          "const": true
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_token_env",
        "bot_token_env",
        "app_token_file",
        "bot_token_file"
      ],
      "properties": {
        "app_token_env": {
          "$ref": "#/$defs/nullableEnvName"
        },
        "bot_token_env": {
          "$ref": "#/$defs/nullableEnvName"
        },
        "app_token_file": {
          "$ref": "#/$defs/nullableAbsolutePath"
        },
        "bot_token_file": {
          "$ref": "#/$defs/nullableAbsolutePath"
        }
      }
    },
    "attachment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_enabled",
        "custody_root",
        "max_files_per_message",
        "max_file_bytes",
        "max_total_bytes",
        "allowed_mime_types",
        "allowed_file_types",
        "timeout_ms",
        "max_retries",
        "max_retry_after_seconds"
      ],
      "properties": {
        "feature_enabled": {
          "type": "boolean"
        },
        "custody_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "max_files_per_message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 209715200
        },
        "allowed_mime_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
          }
        },
        "allowed_file_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._+-]{0,31}$"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "private_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "data_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "forbidden_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/absolutePath"
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "epoch"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/safeRef"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "soulforge.slack_continuous.binding.v1"
          }
        }
      },
      "then": {
        "properties": {
          "feature_enabled": {
            "const": false
          },
          "attachment_policy": {
            "type": "object",
            "properties": {
              "feature_enabled": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "soulforge.slack_continuous.binding.v2"
          }
        }
      },
      "then": {
        "properties": {
          "feature_enabled": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "safeRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,255}$"
    },
    "nullableEnvName": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "anyOf": [
        {
          "pattern": "^[A-Za-z]:[\\\\/]"
        },
        {
          "pattern": "^/"
        }
      ]
    },
    "nullableAbsolutePath": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/absolutePath"
        }
      ]
    }
  }
}
