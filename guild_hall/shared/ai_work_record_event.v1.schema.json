{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schema/ai_work_record_event.v1.schema.json",
  "title": "Soulforge AI Work Record Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "work_id",
    "idempotency_key",
    "event_kind",
    "sequence",
    "previous_event_digest",
    "event_digest",
    "project_ref",
    "task_ref",
    "actor",
    "started_at",
    "occurred_at",
    "recorded_at",
    "status",
    "purpose",
    "scope",
    "source_refs",
    "result_refs",
    "evidence_refs",
    "stop_conditions",
    "uncertainties",
    "metadata_boundary",
    "official_completion",
    "whole_chat_capture",
    "screen_capture",
    "keyboard_capture",
    "os_activity_capture"
  ],
  "properties": {
    "schema_version": {
      "const": "soulforge.ai_work_record_event.v1"
    },
    "event_id": {
      "$ref": "#/$defs/native_id"
    },
    "work_id": {
      "$ref": "#/$defs/native_id"
    },
    "idempotency_key": {
      "$ref": "#/$defs/native_id"
    },
    "event_kind": {
      "enum": [
        "start",
        "checkpoint",
        "closeout_pending",
        "closeout",
        "correction"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_event_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "event_digest": {
      "$ref": "#/$defs/digest"
    },
    "project_ref": {
      "$ref": "#/$defs/native_id"
    },
    "task_ref": {
      "$ref": "#/$defs/native_id"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "started_at": {
      "$ref": "#/$defs/utc_milliseconds"
    },
    "occurred_at": {
      "$ref": "#/$defs/utc_milliseconds"
    },
    "recorded_at": {
      "$ref": "#/$defs/utc_milliseconds"
    },
    "status": {
      "enum": [
        "active",
        "closeout_pending",
        "closed"
      ]
    },
    "purpose": {
      "$ref": "#/$defs/summary_160"
    },
    "scope": {
      "$ref": "#/$defs/summary_240"
    },
    "source_refs": {
      "$ref": "#/$defs/metadata_ref_list"
    },
    "result_refs": {
      "$ref": "#/$defs/non_mapping_metadata_ref_list"
    },
    "evidence_refs": {
      "$ref": "#/$defs/non_mapping_metadata_ref_list"
    },
    "stop_conditions": {
      "$ref": "#/$defs/note_list"
    },
    "uncertainties": {
      "$ref": "#/$defs/note_list"
    },
    "metadata_boundary": {
      "const": "metadata_only"
    },
    "official_completion": {
      "const": false
    },
    "whole_chat_capture": {
      "const": false
    },
    "screen_capture": {
      "const": false
    },
    "keyboard_capture": {
      "const": false
    },
    "os_activity_capture": {
      "const": false
    },
    "closeout_kind": {
      "enum": [
        "completed_candidate",
        "blocked",
        "handoff",
        "abandoned"
      ]
    },
    "correction_ref": {
      "$ref": "#/$defs/correction_ref"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "start"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "sequence": {
            "const": 0
          },
          "previous_event_digest": {
            "type": "null"
          },
          "status": {
            "const": "active"
          },
          "closeout_kind": false,
          "correction_ref": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "checkpoint"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "$ref": "#/$defs/non_start_active"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "closeout_pending"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "allOf": [
          {
            "$ref": "#/$defs/non_start_chain"
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "closeout_pending"
              },
              "closeout_kind": false,
              "correction_ref": false
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "closeout"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "allOf": [
          {
            "$ref": "#/$defs/non_start_chain"
          },
          {
            "type": "object",
            "required": [
              "closeout_kind"
            ],
            "properties": {
              "status": {
                "const": "closed"
              },
              "closeout_kind": {
                "enum": [
                  "completed_candidate",
                  "blocked",
                  "handoff",
                  "abandoned"
                ]
              },
              "correction_ref": false,
              "result_refs": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "ref_kind": {
                      "enum": [
                        "result",
                        "packet"
                      ]
                    }
                  },
                  "required": [
                    "ref_kind"
                  ]
                },
                "minContains": 1
              },
              "evidence_refs": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "ref_kind": {
                      "enum": [
                        "evidence",
                        "tool_receipt",
                        "command_receipt",
                        "file",
                        "git",
                        "test",
                        "build",
                        "packet"
                      ]
                    }
                  },
                  "required": [
                    "ref_kind"
                  ]
                },
                "minContains": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "closeout"
          },
          "closeout_kind": {
            "const": "blocked"
          }
        },
        "required": [
          "event_kind",
          "closeout_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "stop_conditions": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "closeout"
          },
          "closeout_kind": {
            "const": "handoff"
          }
        },
        "required": [
          "event_kind",
          "closeout_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "result_refs": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "ref_kind": {
                  "const": "packet"
                }
              },
              "required": [
                "ref_kind"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "closeout"
          },
          "closeout_kind": {
            "const": "abandoned"
          }
        },
        "required": [
          "event_kind",
          "closeout_kind"
        ]
      },
      "then": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "stop_conditions": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "uncertainties": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "event_kind": {
            "const": "correction"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "allOf": [
          {
            "$ref": "#/$defs/non_start_chain"
          },
          {
            "type": "object",
            "required": [
              "correction_ref"
            ],
            "properties": {
              "status": {
                "const": "closed"
              },
              "closeout_kind": false,
              "correction_ref": {
                "$ref": "#/$defs/correction_ref"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ref_kind": {
                      "enum": [
                        "source",
                        "mapping"
                      ]
                    }
                  },
                  "required": [
                    "ref_kind"
                  ]
                }
              },
              "result_refs": {
                "type": "array",
                "maxItems": 0
              },
              "evidence_refs": {
                "type": "array",
                "maxItems": 0
              },
              "stop_conditions": {
                "type": "array",
                "maxItems": 0
              },
              "uncertainties": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "native_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,119}$",
      "allOf": [
        {
          "$ref": "#/$defs/private_key_sentinel_free"
        }
      ]
    },
    "opaque_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!(?:User|Assistant)\\s*:)(?!.*(?:ghp_|xoxb-|AKIA|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][ _-]+[Kk][Ee][Yy]|password\\s*[:=]|cookie\\s*[:=]|secret\\s*[:=]|token\\s*[:=]|credential\\s*[:=]|api[-_]key\\s*[:=]|authorization\\s*[:=]|bearer(?:\\s+|\\s*[:=])|session[-_](?:token|cookie)\\s*[:=]|(?:access|refresh|auth)[-_]token\\s*[:=]|client[-_]secret\\s*[:=]))[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "utc_milliseconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "summary_160": {
      "allOf": [
        {
          "$ref": "#/$defs/opaque_ref"
        },
        {
          "type": "string",
          "maxLength": 160
        }
      ]
    },
    "summary_240": {
      "$ref": "#/$defs/opaque_ref"
    },
    "private_key_sentinel_free": {
      "type": "string",
      "pattern": "^(?!.*[Pp][Rr][Ii][Vv][Aa][Tt][Ee][ _-]+[Kk][Ee][Yy])"
    },
    "note_list": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/summary_160"
      }
    },
    "non_start_chain": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_event_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "non_start_active": {
      "allOf": [
        {
          "$ref": "#/$defs/non_start_chain"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "active"
            },
            "closeout_kind": false,
            "correction_ref": false
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "agent_id",
        "tool",
        "tool_version"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/native_id"
        },
        "agent_id": {
          "$ref": "#/$defs/native_id"
        },
        "tool": {
          "$ref": "#/$defs/native_id"
        },
        "tool_version": {
          "$ref": "#/$defs/native_id"
        }
      }
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*%)(?!.*\\\\)(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\r\\n\\u0000-\\u001f\\u007f/:]+(?:/[^\\r\\n\\u0000-\\u001f\\u007f/:]+)*$",
      "allOf": [
        {
          "$ref": "#/$defs/private_key_sentinel_free"
        }
      ]
    },
    "metadata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "properties": {
        "ref_kind": {
          "enum": [
            "source",
            "mapping",
            "tool_receipt",
            "command_receipt",
            "file",
            "git",
            "test",
            "build",
            "outbox",
            "packet",
            "result",
            "evidence"
          ]
        },
        "ref_id": {
          "$ref": "#/$defs/opaque_ref"
        },
        "path_ref": {
          "$ref": "#/$defs/path_ref"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "$ref": "#/$defs/native_id"
        },
        "exit_code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "occurred_at": {
          "$ref": "#/$defs/utc_milliseconds"
        },
        "mapping_field": {
          "enum": [
            "event_id",
            "work_id",
            "idempotency_key",
            "project_ref",
            "task_ref"
          ]
        },
        "mapping_alias": {
          "$ref": "#/$defs/native_id"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "ref_kind": {
                "const": "mapping"
              }
            },
            "required": [
              "ref_kind"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "mapping_field",
              "mapping_alias"
            ],
            "properties": {
              "ref_id": {
                "type": "string",
                "not": {
                  "type": "string",
                  "pattern": "^(?:[Ss][Hh][Aa]256:)?[A-Fa-f0-9]{64}$"
                }
              },
              "mapping_field": {
                "enum": [
                  "event_id",
                  "work_id",
                  "idempotency_key",
                  "project_ref",
                  "task_ref"
                ]
              },
              "mapping_alias": {
                "$ref": "#/$defs/native_id"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "mapping_field": false,
              "mapping_alias": false
            }
          }
        }
      ]
    },
    "metadata_ref_list": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/metadata_ref"
      }
    },
    "non_mapping_metadata_ref_list": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/metadata_ref"
          },
          {
            "type": "object",
            "properties": {
              "ref_kind": {
                "not": {
                  "const": "mapping"
                }
              }
            }
          }
        ]
      }
    },
    "correction_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_digest",
        "reason"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/native_id"
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        },
        "reason": {
          "$ref": "#/$defs/summary_160"
        }
      }
    }
  }
}
