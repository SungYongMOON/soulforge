{
  "description": "Non-blocking, metadata-only Soulforge AI usage meter hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/guild_hall/ai_usage_meter/cli.mjs\" hook",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& node (Join-Path (git rev-parse --show-toplevel) 'guild_hall/ai_usage_meter/cli.mjs') hook\"",
            "timeout": 15,
            "statusMessage": "Recording metadata-only lifecycle receipt"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/guild_hall/ai_usage_meter/cli.mjs\" hook",
