{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulforge.engineering_profile.v0",
  "title": "Engineering Profile Authoring Schema v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_kind",
    "profile_id",
    "domain_engine_id",
    "revision_hash",
    "extends_base_pin",
    "source_refs",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "soulforge.engineering_profile.v0"
    },
    "profile_kind": {
      "type": "string",
      "enum": [
        "organization",
        "project"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_engine_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_hash": {
      "type": "string",
      "minLength": 1
    },
    "extends_base_pin": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
