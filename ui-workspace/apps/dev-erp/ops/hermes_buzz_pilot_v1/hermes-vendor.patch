+    def set_message_handler(self, handler):
+        async def observed_handler(event):
+            response = await handler(event)
+            pilot = getattr(event, "_buzz_pilot_observation", None)
+            if pilot is not None and event.message_id == pilot.instruction_message_id:
+                if not isinstance(response, str) or not response.strip():
+                    # Streaming or native routing may consume the final response.
+                    # Missing observer text is not evidence of execution failure.
+                    pilot.mark_capture_gap("observer_final_unobserved")
+                else:
+                    pilot.final_response(response)
+            return response
+        super().set_message_handler(observed_handler)
+
+    async def _send_with_retry(self, chat_id, content, reply_to=None, metadata=None,
+                               max_retries=2, base_delay=2.0):
+        pilot = getattr(self, "_buzz_pilot_observation", None)
+        is_final = (pilot is not None and not getattr(pilot, "terminal", False)
+                    and str(chat_id) == pilot.chat_id and pilot.matches_final(content))
+        previous_final = getattr(self, "_buzz_pilot_final_send", None)
+        if is_final:
+            from tools.hermes_buzz_pilot_hook import PilotCaptureAbort
+            if self._self_pubkey != pilot.bot_pubkey:
+                raise PilotCaptureAbort("pilot_sender_changed")
+            self._buzz_pilot_final_send = content
+        try:
+            result = await super()._send_with_retry(
+                chat_id, content, reply_to=reply_to, metadata=metadata,
+                max_retries=max_retries, base_delay=base_delay,
+            )
+        finally:
+            if is_final:
+                self._buzz_pilot_final_send = previous_final
+        if is_final:
+            observed_result = result
+            if getattr(result, "success", None) is True and not getattr(result, "_buzz_pilot_full_final", False):
+                # Native formatting fallback may clip at 3500 characters.
+                # Its transport ACK is not proof that the full final was sent.
+                from types import SimpleNamespace
+                observed_result = SimpleNamespace(success=None, message_id=getattr(result, "message_id", None))
+            pilot.final_delivery(observed_result)
+        return result
+
+    async def send_clarify(self, chat_id, question, choices, clarify_id, session_key, metadata=None):
+        import sys
+        module = sys.modules.get("tools.hermes_buzz_pilot_hook")
+        pilot = module.for_session(session_key) if module else None
+        try:
+            result = await super().send_clarify(
+                chat_id, question, choices, clarify_id, session_key, metadata=metadata,
+            )
+        except Exception:
+            if pilot is not None:
+                from types import SimpleNamespace
+                pilot.question_delivery(clarify_id, SimpleNamespace(success=None, message_id=None))
+            raise
+        if pilot is not None:
+            pilot.question_delivery(clarify_id, result)
+        return result
+
+    async def on_processing_complete(self, event, outcome):
+        pilot = getattr(event, "_buzz_pilot_observation", None)
+        if pilot is not None and event.message_id == pilot.instruction_message_id:
+            try:
+                if not pilot.terminal:
+                    if getattr(outcome, "value", outcome) == "cancelled":
+                        pilot.cancelled("pilot_cancelled")
+                    elif getattr(outcome, "value", outcome) == "failure":
+                        pilot.failed("pilot_final_delivery_unobserved")
+            except BaseException as exc:
+                from tools.hermes_buzz_pilot_hook import PilotCaptureAbort
+                if not isinstance(exc, PilotCaptureAbort):
+                    raise
+                logger.error("Buzz pilot failure capture unavailable")
+            finally:
+                pilot.processing_complete(outcome)
+                if getattr(self, "_buzz_pilot_observation", None) is pilot:
+                    self._buzz_pilot_observation = None
+        await super().on_processing_complete(event, outcome)
+
